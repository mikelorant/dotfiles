{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "key": "OS",
      "format": "{3} {10} {9} ({11})",
    },
    {
      "type": "host",
      "key": "Model",
      "format": "{2} {3}[{1}]",
    },
    "cpu",
    "gpu",
    {
      "type": "display",
      "key": "Display",
      "format": "{6} {4}x{5} @ {3}Hz [{7}]"
    },
    "shell",
    "terminal",
    "memory",
    {
      "type": "disk",
      "key": "Disk",
      "format": "{1} / {2} ({3})",
    },
    "battery",
    "poweradapter",
    {
      "type": "localip",
      "key": "Local IP",
      "format": "{1}",
    },
    {
      "type": "command",
      "key": "Public IP",
      // "text": "dig +time=1 +tries=1 +short myip.opendns.com @resolver1.opendns.com",
      // "text": "dog -1 myip.opendns.com @resolver1.opendns.com",
      "text": "dog -1 --class=CH --type=TXT whoami.cloudflare @1.1.1.1 | tr -d '\"'",
    },
    "uptime",
  ]
}
